{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1240px"
		},
		"color": {
			"customDuotone": true,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#5b3df0" },
				{ "slug": "secondary", "name": "Secondary", "color": "#00c2a8" },
				{ "slug": "accent", "name": "Accent", "color": "#ff5d73" },
				{ "slug": "heading", "name": "Heading", "color": "#0d0f1a" },
				{ "slug": "text", "name": "Text", "color": "#171923" },
				{ "slug": "text-muted", "name": "Muted Text", "color": "#5a5f70" },
				{ "slug": "background", "name": "Background", "color": "#ffffff" },
				{ "slug": "background-alt", "name": "Light Background", "color": "#f6f7fb" }
			],
			"gradients": [
				{ "slug": "primary-secondary", "name": "Primary to Secondary", "gradient": "linear-gradient(120deg,#5b3df0 0%,#00c2a8 100%)" },
				{ "slug": "primary-accent", "name": "Primary to Accent", "gradient": "linear-gradient(120deg,#5b3df0 0%,#ff5d73 100%)" },
				{ "slug": "dark-fade", "name": "Dark Fade", "gradient": "linear-gradient(0deg,rgba(13,15,26,.9) 0%,rgba(13,15,26,0) 60%)" }
			]
		},
		"typography": {
			"customFontSize": true,
			"lineHeight": true,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Heading",
					"fontFamily": "'Plus Jakarta Sans', -apple-system, 'Segoe UI', sans-serif"
				},
				{
					"slug": "body",
					"name": "Body",
					"fontFamily": "'Inter', -apple-system, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.125rem" },
				{ "slug": "large", "name": "Large", "size": "1.75rem" },
				{ "slug": "x-large", "name": "Extra Large", "size": "2.75rem" },
				{ "slug": "xx-large", "name": "Huge", "size": "3.6rem" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--cxc-bg)",
			"text": "var(--cxc-text)"
		},
		"typography": {
			"fontFamily": "'Inter', -apple-system, 'Segoe UI', sans-serif",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "'Plus Jakarta Sans', -apple-system, 'Segoe UI', sans-serif",
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--cxc-primary)"
				}
			},
			"button": {
				"border": {
					"radius": "100px"
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "100px"
				}
			}
		}
	}
}
